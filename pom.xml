<?xml version="1.0" encoding="UTF-8"?>
<!--
  POM padre del monorepo DuocConecta.
  Centraliza la versión de Java, la de Spring Boot y las de las librerías compartidas,
  para que ningún módulo hijo fije versiones por su cuenta.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>cl.duoc.duocconecta</groupId>
    <artifactId>duocconecta</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>DuocConecta</name>
    <description>Plataforma de networking y vitrina de proyectos de Duoc UC</description>

    <!--
      El frontend (frontend-web) NO se declara acá: se construye con npm/Vite aparte
      para no acoplar el build de Java con el del navegador.
    -->
    <modules>
        <module>common-seguridad</module>
        <module>ms-usuarios</module>
        <module>ms-proyectos</module>
        <module>ms-contacto</module>
        <module>bff-web</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <spring-security.version>7.1.1</spring-security.version>

        <aws.sdk.version>2.35.9</aws.sdk.version>
        <springdoc.version>3.1.0</springdoc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Swagger UI / OpenAPI 3.1. La línea 3.x de springdoc es la compatible con Boot 4. -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- SDK de AWS. Solo ms-proyectos lo usa, para firmar la subida de adjuntos a S3. -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Módulo propio con la validación de JWT compartida por todos los servicios. -->
            <dependency>
                <groupId>cl.duoc.duocconecta</groupId>
                <artifactId>common-seguridad</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                  El plugin de Spring Boot solo debe empaquetar los servicios ejecutables.
                  Cada módulo que produce un jar arrancable lo activa en su propio pom.
                -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
