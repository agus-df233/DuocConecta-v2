# Plantilla de variables del frontend. Cópiala a .env.local y completa los valores.
# Vite solo expone al navegador las variables que empiezan con VITE_. Nada de esto es secreto:
# los identificadores viajan dentro de cada token.

# --- Login con Microsoft (MSAL contra Azure AD / Entra ID) ---
# Client ID del registro DuocConecta-Web (el SPA). Es DISTINTO del de la API.
VITE_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# Scope de la API. Tiene que ser este y no "openid profile": si se piden solo los scopes
# de OIDC, Microsoft devuelve un ID token cuya audiencia es el SPA y el backend lo rechaza con 401.
VITE_AZURE_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user

# --- Login con Google (oidc-client-ts contra Amazon Cognito) ---
# "./infra/aws.sh cognito" muestra los valores. Vacíos = el botón de Google avisa que no está disponible.
VITE_COGNITO_AUTORIDAD=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_DOMINIO=duocconecta-<cuenta>.auth.us-east-1.amazoncognito.com

# URL del BFF:
#   - Backend local:  http://localhost:8080
#   - Backend en AWS: vacío, para llamar al mismo origen del API Gateway
VITE_BFF_URL=http://localhost:8080
