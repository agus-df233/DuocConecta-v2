# Plantilla de variables de entorno de DuocConecta.
# Copiala a .env y completa los valores. El archivo .env NUNCA se sube al repositorio.
#
#   cp .env.example .env

# --- Azure AD (Microsoft Entra ID) ---
# Directory (tenant) ID del tenant de Duoc UC.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# Application (client) ID del registro de la API (DuocConecta-API).
# Es la audiencia que los servicios validan en el token.
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# --- Base de datos PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/duocconecta
DB_USER=duocconecta
DB_PASSWORD=cambiame

# --- CORS del BFF ---
# Lista separada por comas. Sin comodines: cada origen se declara explícitamente.
# El frontend corre siempre en localhost porque Azure AD exige HTTPS en las URI de
# redirección y el laboratorio no habilita CloudFront.
CORS_ORIGENES=http://localhost:5173

# --- Comunicación interna ---
# URL con la que el BFF llama a ms-usuarios.
MS_USUARIOS_URL=http://localhost:8081

# --- Frontend (Fase 2, se leen desde Vite) ---
# Application (client) ID del registro del SPA (DuocConecta-Web). Es DISTINTO del de la API.
VITE_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# Scope de la API que MSAL debe pedir. Si se piden solo "openid profile",
# Microsoft devuelve un ID token y el backend lo rechaza con 401.
VITE_AZURE_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
VITE_BFF_URL=http://localhost:8080
