# Plantilla de variables de entorno de DuocConecta.
# Copiala a .env y completa los valores. El archivo .env NUNCA se sube al repositorio.
#
#   cp .env.example .env

# --- Login con Microsoft: Azure AD (Microsoft Entra ID) ---
# Directory (tenant) ID del tenant.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# Application (client) ID del registro de la API (DuocConecta-API).
# Es la audiencia que los servicios validan en el token.
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# --- Login con Google: Amazon Cognito (opcional) ---
# Emisor del user pool: https://cognito-idp.<región>.amazonaws.com/<user pool id>, sin barra final.
# "./infra/aws.sh cognito" crea el user pool y muestra los valores. Vacíos = solo Microsoft.
COGNITO_ISSUER_URI=
# Client ID del app client: es la audiencia ('aud') del ID token de Cognito.
COGNITO_AUDIENCIA=

# Correos con rol ADMINISTRADOR, separados por coma (además del App Role o del grupo ADMINISTRADOR).
ADMINISTRADORES=

# --- Base de datos PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/duocconecta
DB_USER=duocconecta
DB_PASSWORD=cambiame

# --- CORS del BFF ---
# Lista separada por comas. Sin comodines: cada origen se declara explícitamente.
# En local el frontend corre en localhost; en la nube, el origen del API Gateway se agrega solo.
CORS_ORIGENES=http://localhost:5173

# --- Comunicación interna ---
# URL con la que el BFF llama a ms-usuarios.
MS_USUARIOS_URL=http://localhost:8081

# --- Frontend (Fase 2, se leen desde Vite) ---
# Login con Microsoft (MSAL). Application (client) ID del registro del SPA (DuocConecta-Web),
# DISTINTO del de la API, y el scope de la API.
VITE_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
# Login con Google (oidc-client-ts contra Cognito). Vacíos = el botón de Google avisa que no está.
VITE_COGNITO_AUTORIDAD=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMINIO=
VITE_BFF_URL=http://localhost:8080

# --- Mensajería (EP2): Amazon SNS + SQS ---
# Región de AWS. Las credenciales NO van aquí: en local salen de ~/.aws/credentials (panel
# "AWS Details" del Learner Lab) y en Fargate de LabRole.
AWS_REGION=us-east-1
# ARN del tópico SNS donde ms-proyectos y ms-contacto publican. Vacío = los eventos solo se
# registran en el log. Se obtiene con "make mensajeria" (queda en infra/.recursos).
SNS_TOPICO_EVENTOS_ARN=
# En falso, ms-notificaciones no arranca sus consumidores (útil sin credenciales de AWS).
CONSUMIDORES_ACTIVOS=true
# Solo para la demo: un evento con detalle "simular-fallo-recuperable" falla a propósito.
PERMITIR_FALLOS_SIMULADOS=false

# RabbitMQ (EP2). Por defecto, el clúster local de docker-compose. En false, solo SNS/SQS.
RABBITMQ_HABILITADA=true
RABBITMQ_ADDRESSES=localhost:5672,localhost:5673
RABBITMQ_USUARIO=duocconecta
RABBITMQ_CLAVE=duocconecta   # solo local; en la nube sale de Secrets Manager
